{
  "manifest_version": 3,
  "name": "PassMed Progress Tracker",
  "version": "1.1.1",
  "description": "Extract progress data from PassMed and sync with your UKMLA tracker",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.passmedicine.com/*",
    "https://passmedicine.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.passmedicine.com/*",
        "https://passmedicine.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js"
      ],
      "matches": [
        "https://www.passmedicine.com/*",
        "https://passmedicine.com/*"
      ]
    }
  ]
}
